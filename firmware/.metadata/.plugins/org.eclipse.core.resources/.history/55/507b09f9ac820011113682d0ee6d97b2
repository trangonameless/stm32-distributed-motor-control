#include "motor_control.h"
#include "tim.h"


void Motor_SetSpeed(uint8_t speed)
{
    uint32_t pulse;

    pulse = speed * 100 / 100;

    __HAL_TIM_SET_COMPARE(&htim2,
                          TIM_CHANNEL_1,
                          pulse);
}


void Motor_Stop(void)
{
    __HAL_TIM_SET_COMPARE(&htim2,
                          TIM_CHANNEL_1,
                          0);
}

